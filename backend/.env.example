# GlobeTrotter Backend Environment Variables
APP_NAME=GlobeTrotter Travel Intelligence
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=True

# Database (PostgreSQL + PostGIS)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/globetrotter
SYNC_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/globetrotter
REDIS_URL=redis://localhost:6379/0

# Security & JWT Auth
SECRET_KEY=globetrotter-super-secret-dev-key-change-in-production-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# Local AI Engine (Ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# WhatsApp Concierge Desk
WHATSAPP_ASSIST_PHONE=+919876543210
